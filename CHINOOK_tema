FORMULARIO CHINOOK — TECNICHE DI PROGRAMMAZIONE

======================================================================
0. MAPPA DATABASE: JOIN CHE SI RIPETONO
======================================================================
Artist(ArtistId) -> Album(ArtistId) -> Track(AlbumId)
Track(GenreId) -> Genre(GenreId)
Track(TrackId) -> PlaylistTrack(TrackId) -> Playlist(PlaylistId)
Customer(CustomerId) -> Invoice(CustomerId) -> InvoiceLine(InvoiceId)
InvoiceLine(TrackId) -> Track(TrackId) -> Album -> Artist

ATTENZIONE: in Chinook standard la tabella delle righe si chiama InvoiceLine;
nel codice SQL controllare maiuscole e nomi effettivi delle tabelle.

QUERY 1: ARTISTI CON ALMENO UN BRANO

SELECT DISTINCT ar.ArtistId, ar.Name
FROM Artist ar
JOIN Album al ON al.ArtistId = ar.ArtistId
JOIN Track t ON t.AlbumId = al.AlbumId;

QUERY 2: ALBUM CON ALMENO UN BRANO
SELECT DISTINCT al.AlbumId, al.Title, al.ArtistId
FROM Album al JOIN Track t ON t.AlbumId = al.AlbumId;

QUERY 3: PAESI PER DROPDOWN (GIUGNO A)
SELECT DISTINCT Country FROM Customer
WHERE Country IS NOT NULL ORDER BY Country;

QUERY 4: GENERI PER DROPDOWN (SIMULAZIONE 11)
SELECT GenreId, Name FROM Genre ORDER BY Name;

QUERY 5: ARTISTI CON BRANI DEL GENERE SELEZIONATO (SIM. 11)
SELECT DISTINCT ar.ArtistId, ar.Name
FROM Artist ar
JOIN Album al ON al.ArtistId = ar.ArtistId
JOIN Track t ON t.AlbumId = al.AlbumId
WHERE t.GenreId = %s;

QUERY 6: CLIENTI DI UN PAESE CON ALMENO UNA FATTURA (GIUGNO A)
SELECT DISTINCT c.CustomerId, c.FirstName, c.LastName, c.Country
FROM Customer c JOIN Invoice i ON i.CustomerId = c.CustomerId
WHERE c.Country = %s;

QUERY 7: FATTURATO PER CLIENTE (GIUGNO A)
SELECT c.CustomerId, COALESCE(SUM(i.Total), 0) AS fatturato
FROM Customer c LEFT JOIN Invoice i ON i.CustomerId = c.CustomerId
GROUP BY c.CustomerId;

QUERY 8: GENERI DISTINTI DI OGNI ALBUM (GIUGNO B)
SELECT DISTINCT t.AlbumId, t.GenreId
FROM Track t WHERE t.AlbumId IS NOT NULL;

QUERY 9: PLAYLIST DISTINTE DI OGNI ARTISTA (GIUGNO C)
SELECT DISTINCT al.ArtistId, pt.PlaylistId
FROM Album al
JOIN Track t ON t.AlbumId = al.AlbumId
JOIN PlaylistTrack pt ON pt.TrackId = t.TrackId;

QUERY 10: NUMERO DI BRANI PER ARTISTA (GIUGNO C)
SELECT al.ArtistId, COUNT(t.TrackId) AS n_brani
FROM Album al JOIN Track t ON t.AlbumId = al.AlbumId
GROUP BY al.ArtistId;

QUERY 11: NUMERO DI BRANI PER ALBUM (GIUGNO B)
SELECT t.AlbumId, COUNT(*) AS n_brani
FROM Track t GROUP BY t.AlbumId;

QUERY 12: POPOLARITA' PER ARTISTA (SIM. 11)
-- La traccia definisce popolarità come somma dei brani acquistati.
-- Quantity conteggia le unità vendute, non le sole righe.
SELECT al.ArtistId, COALESCE(SUM(il.Quantity), 0) AS popolarita
FROM Album al
JOIN Track t ON t.AlbumId = al.AlbumId
LEFT JOIN InvoiceLine il ON il.TrackId = t.TrackId
GROUP BY al.ArtistId;

QUERY 13: CLIENTE - ARTISTA ACQUISTATO (GIUGNO A)
SELECT DISTINCT i.CustomerId, al.ArtistId
FROM Invoice i
JOIN InvoiceLine il ON il.InvoiceId = i.InvoiceId
JOIN Track t ON t.TrackId = il.TrackId
JOIN Album al ON al.AlbumId = t.AlbumId;

QUERY 14: ARTISTA - CLIENTE ACQUIRENTE (SIM. 11)
SELECT DISTINCT al.ArtistId, i.CustomerId
FROM Album al
JOIN Track t ON t.AlbumId = al.AlbumId
JOIN InvoiceLine il ON il.TrackId = t.TrackId
JOIN Invoice i ON i.InvoiceId = il.InvoiceId;

