# SIM. 11: cammino più lungo, pesi STRETTAMENTE CRESCENTI
# Usare questi due metodi INSIEME, non mescolare _ricorsione di altre tracce.
def sim11_getBestPath(self, source):
    self._bestPath = [source]
    self._sim11_dfs([source], None)
    return self._bestPath

def _sim11_dfs(self, partial, previous_weight):
    if len(partial) > len(self._bestPath):
        self._bestPath = partial.copy()
    for _, nxt, data in self._graph.out_edges(partial[-1], data=True):
        w = data['weight']
        if nxt not in partial and (previous_weight is None or w > previous_weight):
            partial.append(nxt)
            self._sim11_dfs(partial, w)
            partial.pop()

# GIUGNO A: cammino più lungo, fatturati NON CRESCENTI (<=)
def giugnoA_getBestPath(self, source):
    self._bestPath = [source]
    self._giugnoA_dfs([source])
    return self._bestPath

def _giugnoA_dfs(self, partial):
    if len(partial) > len(self._bestPath):
        self._bestPath = partial.copy()
    current = partial[-1]
    for nxt in self._graph.successors(current):
        if nxt in partial or nxt.fatturato > current.fatturato:
            continue
        partial.append(nxt)
        self._giugnoA_dfs(partial)
        partial.pop()
# ADATTARE .fatturato (attributo del Customer o mappa nel Model).

# GIUGNO B: N album, componenti TUTTE DIVERSE, primo fissato,
# massimo numero complessivo di brani.
def giugnoB_getBestSelection(self, source, n):
    if source not in self._graph or n < 1:
        return [], None
    comps = list(nx.connected_components(self._graph))
    others = [c for c in comps if source not in c]
    self._bestSelection = []
    self._bestScore = float('-inf')
    self._giugnoB_dfs(others, 0, [source], n, len(source.Tracks))
    return (self._bestSelection, self._bestScore) if self._bestSelection else ([], None)

def _giugnoB_dfs(self, comps, index, partial, n, score):
    if len(partial) == n:
        if score > self._bestScore:
            self._bestScore, self._bestSelection = score, partial.copy()
        return
    if index == len(comps) or len(partial) + len(comps) - index < n:
        return
    self._giugnoB_dfs(comps, index + 1, partial, n, score)  # salto componente
    for album in comps[index]:
        partial.append(album)
        self._giugnoB_dfs(comps, index + 1, partial, n, score + len(album.Tracks))
        partial.pop()
# ADATTARE .Tracks (lista di brani caricata dal DAO).

# GIUGNO C: N artisti; ciascun nuovo nodo adiacente ad almeno uno scelto;
# nessuna coppia del gruppo può essere collegata con peso 1.
def giugnoC_getBestGroup(self, source, n):
    if source not in self._graph or n < 1:
        return [], None
    self._bestGroup = []
    self._bestScore = float('-inf')
    self._giugnoC_dfs([source], n, len(source.Tracks))
    return (self._bestGroup, self._bestScore) if self._bestGroup else ([], None)

def _giugnoC_dfs(self, partial, n, score):
    if len(partial) == n:
        if score > self._bestScore:
            self._bestScore, self._bestGroup = score, partial.copy()
        return
    candidates = set()
    for u in partial:
        candidates.update(self._graph.neighbors(u))
    for v in candidates:
        if v in partial:
            continue
        if any(self._graph.has_edge(v, u) and
               self._graph[v][u]['weight'] == 1 for u in partial):
            continue
        partial.append(v)
        self._giugnoC_dfs(partial, n, score + len(v.Tracks))
        partial.pop()
