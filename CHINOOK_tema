# GENERICI
self._graph.number_of_nodes()
self._graph.number_of_edges()

# INFLUENZA (SIM. 11 e GIUGNO A): solo DiGraph pesato
def getMostInfluential(self):
    if not self._graph.nodes:
        return None, None
    return max(
        ((v, self._graph.out_degree(v, weight='weight')
              - self._graph.in_degree(v, weight='weight'))
         for v in self._graph.nodes),
        key=lambda item: item[1]
    )

# TOP 5 PESATI (SIM.11 e GIUGNO A)
def getTop5Edges(self):
    return sorted(self._graph.edges(data=True),
                  key=lambda e: e[2]['weight'], reverse=True)[:5]

# COMPONENTI (GIUGNO B): Graph NON ORIENTATO
nx.number_connected_components(self._graph)
components = list(nx.connected_components(self._graph))
largest = max(components, key=len) if components else set()
albums_sorted = sorted(largest, key=lambda a: a.Title)
# Per numero brani: len(album.Tracks) oppure mappa conteggi caricata dal DAO.

# GRADO / SOMMA PESI (GIUGNO C)
max_degree = max(self._graph.degree, key=lambda x: x[1], default=(None, None))
max_weighted_degree = max(
    self._graph.degree(weight='weight'), key=lambda x: x[1], default=(None, None)
)

# TOP 10 (GIUGNO C): normalizzare gli estremi nel grafo non orientato
def getTop10Edges(self):
    edges = []
    for u, v, data in self._graph.edges(data=True):
        a, b = sorted((u, v), key=lambda n: (n.Name, n.ArtistId))
        edges.append((a, b, data['weight']))
    return sorted(edges, key=lambda e: (-e[2], e[0].Name, e[1].Name))[:10]
# Controller: for a,b,peso in ... (NON for a,b,data).

