# A) RELAZIONE IN COMUNE: usare set di ID (B, C, A, sim.11)
# DAO deve restituire coppie (id_nodo, id_relazione).
# Mappa: relazioni[id_nodo] = {id1, id2, ...}
from collections import defaultdict
relazioni = defaultdict(set)
for id_nodo, id_relazione in DAO.getPairs():
    relazioni[id_nodo].add(id_relazione)

# B) GRAPH NON ORIENTATO, arco se intersezione NON VUOTA (GIUGNO B)
for i in range(len(nodes)):
    for j in range(i + 1, len(nodes)):
        a, b = nodes[i], nodes[j]
        comuni = relazioni[a.AlbumId] & relazioni[b.AlbumId]
        if comuni:
            self._graph.add_edge(a, b)

# C) GRAPH NON ORIENTATO PESATO: peso = cardinalità intersezione (GIUGNO C)
for i in range(len(nodes)):
    for j in range(i + 1, len(nodes)):
        a, b = nodes[i], nodes[j]
        comuni = relazioni[a.ArtistId] & relazioni[b.ArtistId]
        if comuni:
            self._graph.add_edge(a, b, weight=len(comuni))

# D) DIGRAPH PESATO: confronto attributo e doppio arco in caso di parità
# (GIUGNO A: valore=fatturato; SIM.11: valore=popolarita)
for i in range(len(nodes)):
    for j in range(i + 1, len(nodes)):
        a, b = nodes[i], nodes[j]
        if not (relazioni[ID(a)] & relazioni[ID(b)]):
            continue
        va, vb = VALORE(a), VALORE(b)  # ADATTARE
        peso = va + vb
        if va > vb:
            self._graph.add_edge(a, b, weight=peso)
        elif vb > va:
            self._graph.add_edge(b, a, weight=peso)
        else:
            self._graph.add_edge(a, b, weight=peso)
            self._graph.add_edge(b, a, weight=peso)
# ID e VALORE sono segnaposto, NON funzioni già esistenti.
# A: ID = CustomerId; VALORE = fatturato
# Sim.11: ID = ArtistId; VALORE = popolarita
# IMPORTANTE: self._graph.add_nodes_from(nodes) PRIMA degli archi.

