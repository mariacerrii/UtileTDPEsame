@staticmethod
def getTracksForArtist(artistId):
    conn = DBConnect.get_connection()
    cursor = conn.cursor(dictionary=True)
    query = """
        SELECT t.TrackId
        FROM Track t
        JOIN Album al ON t.AlbumId = al.AlbumId
        WHERE al.ArtistId = %s
    """
    cursor.execute(query, (artistId,))
    result = [row['TrackId'] for row in cursor]
    cursor.close()
    conn.close()
    return result

