5) MODEL: CARICARE I NODI
-------------------------
import networkx as nx
from database.DAO import DAO

class Model:
    def __init__(self):
        self._graph = nx.Graph()       # oppure nx.DiGraph()
        self._nodes = []
        self._idMap = {}

    def buildGraph(self):
        self._graph.clear()            # evita duplicati tra costruzioni
        self._nodes = DAO.getAllArtists()
        self._graph.add_nodes_from(self._nodes)
        self._idMap = {a.ArtistId: a for a in self._nodes}
        # QUI si aggiungono gli archi (vedi 02_ARCHI.txt)

    def getNumNodes(self):
        return self._graph.number_of_nodes()

    def getArtists(self):
        return list(self._graph.nodes)

