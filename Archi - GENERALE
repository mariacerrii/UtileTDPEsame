        FROM ...
        -- MODIFICARE: JOIN TRA LE TABELLE
        JOIN ...
        -- MODIFICARE: CONDIZIONE DI COLLEGAMENTO
        WHERE ...
        -- MODIFICARE SE NECESSARIO:
