self._graph = nx.DiGraph()
# Dopo aver recuperato u e v
# 1. MODIFICARE: CALCOLO DEL PESO
peso = u.Fatturato + v.Fatturato
# 2. MODIFICARE: ATTRIBUTO CHE STABILISCE LA DIREZIONE
if u.Fatturato > v.Fatturato:
    # Arco da u verso v
    self._graph.add_edge(u, v, weight=peso)

elif v.Fatturato > u.Fatturato:
    # Arco da v verso u
    self._graph.add_edge(v, u, weight=peso)

else:
    # 3. MODIFICARE: GESTIONE DELLA PARITÀ
    # Aggiungere entrambi SOLO se richiesto
    self._graph.add_edge(u, v, weight=peso)
    self._graph.add_edge(v, u, weight=peso)

