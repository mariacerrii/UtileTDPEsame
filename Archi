6) METODO C — COSTRUIRE I PESI A PARTIRE DA GRUPPI CONDIVISI
from collections import defaultdict
from itertools import combinations

# Esempio GENERICO: DAO.getMemberships() -> coppie (group_id, node_id)
gruppi = defaultdict(set)
for group_id, node_id in DAO.getMemberships():
    gruppi[group_id].add(node_id)

pesi = defaultdict(int)
for membri in gruppi.values():
    for id1, id2 in combinations(sorted(membri), 2):
        pesi[(id1, id2)] += 1

for (id1, id2), peso in pesi.items():
    self._graph.add_edge(self._idMap[id1], self._idMap[id2], weight=peso)

# Utile quando il peso = numero di gruppi condivisi.
# Gli ID devono essere ordinabili per usare sorted(); altrimenti normalizzare le coppie.

7) ARCHI ORIENTATI — DIREZIONE DETERMINATA DA UNA REGOLA
# Usare nx.DiGraph() nel costruttore.
for u, v in combinations(self._nodes, 2):
    if u.Valore < v.Valore:
        self._graph.add_edge(u, v)
    elif v.Valore < u.Valore:
        self._graph.add_edge(v, u)
    else:
        # SOLO SE la consegna prevede entrambi i versi in caso di parità
        self._graph.add_edge(u, v)
        self._graph.add_edge(v, u)

# Se la direzione è già nella query, NON invertire arbitrariamente u e v.

