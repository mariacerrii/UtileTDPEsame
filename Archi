9) LEGGERE GLI ARCHI / STATISTICHE
self._graph.number_of_edges()               # numero archi
self._graph.has_edge(u, v)                   # esistenza arco
self._graph[u][v]['weight']                  # peso (solo se arco esistente)
self._graph.edges(data=True)                 # (u, v, {'weight': ...})
self._graph.neighbors(u)                     # vicini (Graph e DiGraph: successori)
self._graph.degree(u)                        # grado
self._graph.degree(u, weight='weight')       # somma pesi incidenti

# DiGraph: distinguere entranti / uscenti
self._graph.successors(u)
self._graph.predecessors(u)
self._graph.in_degree(u)
self._graph.out_degree(u)
self._graph.in_degree(u, weight='weight')
self._graph.out_degree(u, weight='weight')

10) TOP-N ARCHI CON PESI
# Ordine decrescente per peso:
top10 = sorted(
    self._graph.edges(data=True),
    key=lambda e: e[2]['weight'],
    reverse=True
)[:10]

# Parità: peso decrescente, nomi alfabetici, indipendenti dall'ordine degli estremi
# (utile per Graph non orientato):
top10 = sorted(
    self._graph.edges(data=True),
    key=lambda e: (
        -e[2]['weight'],
        min(e[0].Name, e[1].Name),
        max(e[0].Name, e[1].Name)
    )
)[:10]

# ATTENZIONE: edges(data=True) -> terzo elemento = dizionario.
# edges(data='weight') -> terzo elemento = valore numerico del peso.




