METODO B — getEdgePeso(u, v)
Quando utilizzarlo?
Quando vuoi verificare il collegamento e calcolare il peso per una coppia di nodi alla volta

1) DAO.py
@staticmethod
def getEdgePeso(u, v):
    conn = DBConnect.get_connection()
    cursor = conn.cursor(dictionary=True)

    query = """
        SELECT

            -- MODIFICARE: ELEMENTI DA CONTARE
            COUNT(DISTINCT elemento.Id) AS peso

        FROM ...

        -- MODIFICARE: JOIN
        JOIN ...

        WHERE ...

        -- MODIFICARE: ID DEI DUE NODI
        AND n1.Id = %s
        AND n2.Id = %s
    """

    # MODIFICARE: ATTRIBUTI ID
    cursor.execute(
        query,
        (u.ArtistId, v.ArtistId)
    )

    row = cursor.fetchone()
    cursor.close()
    conn.close()
    return row["peso"]

